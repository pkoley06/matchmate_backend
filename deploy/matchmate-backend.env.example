# ==============================================================================
# MatchMate Backend - Production Environment Template
# Reference only - copy to /etc/matchmate-backend.env on the VM (chmod 600, root:root)
# Real values live ONLY in /etc/matchmate-backend.env (NEVER commit secrets to git)
# ==============================================================================

# Server Network Configuration (binds to loopback behind firewall/reverse proxy)
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Forwarded headers strategy (for reverse proxy / SSL termination)
SERVER_FORWARD_HEADERS_STRATEGY=framework

# JVM Memory and Garbage Collection Tuning
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# PostgreSQL Database Connection (uses the application's actual property names)
DB_NAME=matchmate_db
DB_USER=dev_user
DB_PASSWORD=matchmate
DB_URL=jdbc:postgresql://127.0.0.1:5432/matchmate_db

# Security & JWT Configuration (HMAC secret: 32+ random bytes base64 encoded)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-base64-encoded-secret-key-32-bytes-minimum

# Firebase Admin SDK Credentials Path (mapped read-only into container)
FIREBASE_CREDENTIALS_PATH=file:/etc/matchmate-backend/firebase-service-account.json

# Admin Console Bootstrap Seed (Used only if admin_users table is empty)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me-strong-admin-password

# Object storage for profile/listing photo uploads (see DEPLOY-RUNBOOK.md Step F).
# Leave STORAGE_PROVIDER unset/local ONLY for local dev — this container runs read-only
# with no persistent volume, so "local" here would lose every uploaded photo on restart.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=matchmate-photos
STORAGE_REGION=us-ashburn-1
STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
STORAGE_ACCESS_KEY=change-me-customer-secret-key-access-key
STORAGE_SECRET_KEY=change-me-customer-secret-key-secret-key
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_PUBLIC_BASE_URL=https://<namespace>.objectstorage.us-ashburn-1.oraclecloud.com/n/<namespace>/b/matchmate-photos/o
