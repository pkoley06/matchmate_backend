# =====================================================================
# MatchMate backend - TEMPLATE for .env  (this file IS committed; .env is NOT)
#
# Setup on a new machine:
#   1. Copy-Item .env.example .env
#   2. Fill in the values below
#   3. Put the Firebase service-account JSON at secrets/firebase-service-account.json
#
# Read automatically by:
#   - Spring Boot  (spring.config.import in application.yml)
#   - Docker Compose (docker compose reads .env next to docker-compose.yml)
# =====================================================================

# --- Database ---
DB_NAME=matchmate_db
DB_USER=dev_user
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/matchmate_db

# --- JWT signing secret: 32 random bytes, Base64 encoded. Generate with PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Use a DIFFERENT value in production.
JWT_SECRET=

# --- Firebase Admin SDK service-account file ---
# Download: Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_CREDENTIALS_PATH=file:./secrets/firebase-service-account.json

# --- Admin console (matchmate_admin) first-login seed ---
# Only used once, the first time the app starts with an empty admin_users table.
# Pick your own values; nothing is pre-set in the code.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
